# syntax=docker/dockerfile:1.7
ARG PYTHON_IMAGE=python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f
FROM node:22-bookworm-slim AS web-builder
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1 API_ORIGIN=http://127.0.0.1:8000
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv
FROM ${PYTHON_IMAGE} AS api-builder
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY --from=uv /uv /bin/uv
WORKDIR /build
COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --no-install-project
COPY backend/src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-dev --no-editable

FROM ${PYTHON_IMAGE} AS production
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 klack \
    && useradd --uid 10001 --gid 10001 --create-home klack
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=192 HOSTNAME=0.0.0.0 PORT=10000
COPY --from=web-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=api-builder /opt/venv /opt/venv
WORKDIR /app/backend
COPY --chown=klack:klack backend/alembic.ini ./
COPY --chown=klack:klack backend/alembic ./alembic
COPY --from=web-builder --chown=klack:klack /web/.next/standalone /app/frontend
COPY --from=web-builder --chown=klack:klack /web/.next/static /app/frontend/.next/static
COPY --chown=klack:klack deploy/run.py /app/run.py
USER klack
EXPOSE 10000
CMD ["python", "/app/run.py"]
