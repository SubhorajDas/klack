# Application settings shared by host-run commands and Compose.
# development permits unverified memberships; production/staging require verified email.
APP_ENV=development
APP_NAME=klack-api
APP_VERSION=0.1.0
APP_DEBUG=false
# Optional LiveKit Cloud credentials for private voice calls (server-side only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL container settings used by Compose. Keep local credentials URL-safe because Compose
# constructs the container-internal DATABASE_URL from these values.
POSTGRES_DB=klack
POSTGRES_USER=klack
POSTGRES_PASSWORD=klack_dev
POSTGRES_PORT=5432

# Host-only application connection. Compose replaces this with a URL that uses the `postgres`
# service hostname.
DATABASE_URL=postgresql+asyncpg://klack:klack_dev@127.0.0.1:5432/klack

# SQLAlchemy and database safeguards
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Operational endpoints
HEALTHCHECK_TIMEOUT_SECONDS=2

# Browser authentication. Replace all three secrets outside local development; they must be
# distinct and at least 32 characters. Production also requires HTTPS and secure cookies.
AUTH_JWT_SECRET=development-jwt-secret-change-me-00000001
AUTH_REFRESH_SECRET=development-refresh-secret-change-me-00002
AUTH_ACTION_SECRET=development-action-secret-change-me-0000003
AUTH_ISSUER=klack-api
AUTH_AUDIENCE=klack-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_REFRESH_MIN_INTERVAL_SECONDS=300
AUTH_TRUSTED_ORIGIN=http://127.0.0.1:8000
AUTH_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_PASSWORD_MAX_CONCURRENCY=2
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RECOVERY_TTL_SECONDS=3600
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_REGISTRATION_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_EMAIL_ACTION_RATE_LIMIT=5
AUTH_ACTION_COMPLETE_RATE_LIMIT=10

# Redis handles temporary activity and online leases; PostgreSQL owns durable message/read state.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
PRESENCE_LEASE_SECONDS=75

# Workspace invitations. Keep this secret distinct from every authentication secret and replace
# the checked-in development value in staging and production.
WORKSPACE_INVITATION_SECRET=development-workspace-invitation-secret-change-me-00004
WORKSPACE_INVITATION_TTL_SECONDS=604800

# Explicit opt-in for the local-only Swagger fixture command. The command refuses to run unless
# APP_ENV=development and DEV_SEED_ENABLED=true.
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=KlackSwagger2026!

# Identity maintenance worker. Blank SMTP values disable delivery while cleanup keeps running.
# Set STARTTLS=false and USE_SSL=true for implicit TLS providers.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=
IDENTITY_OUTBOX_BATCH_SIZE=50
IDENTITY_OUTBOX_LEASE_SECONDS=300
IDENTITY_CLEANUP_RETENTION_SECONDS=604800
IDENTITY_CLEANUP_BATCH_SIZE=1000
IDENTITY_WORKER_POLL_SECONDS=10
IDENTITY_CLEANUP_INTERVAL_SECONDS=3600

# Development-container file watching; polling is reliable across Windows, WSL, macOS, and Linux.
WATCHFILES_FORCE_POLLING=true

# Committed message fanout. WebSocket writes remain disabled; clients mutate through REST.
REALTIME_ENABLED=true
REALTIME_MAX_CONNECTIONS=2000
REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=100
REALTIME_OUTBOUND_QUEUE_SIZE=256
REALTIME_MAX_FRAME_BYTES=16384
REALTIME_HEARTBEAT_SECONDS=30
REALTIME_LISTENER_RETRY_SECONDS=2
REALTIME_AUTHORIZATION_RECHECK_SECONDS=30
REALTIME_EVENT_RETENTION_SECONDS=86400
REALTIME_CLEANUP_INTERVAL_SECONDS=3600
REALTIME_CLEANUP_BATCH_SIZE=1000
REALTIME_COMMANDS_PER_MINUTE=120

# Private file sharing (local storage for development only).
FILES_ENABLED=true
FILES_STORAGE=local
FILES_LOCAL_PATH=.data/files
FILES_MAX_BYTES=26214400
FILES_MAX_ATTACHMENTS=5
FILES_WORKSPACE_QUOTA_BYTES=5368709120
FILES_UPLOADS_PER_HOUR=100
# Production requires private S3/Supabase storage. Scanning is required unless explicitly waived.
FILES_S3_BUCKET=
FILES_S3_ENDPOINT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FILES_SCAN_HOST=
FILES_SCAN_REQUIRED=true
FILES_SCAN_PORT=3310
# S3 uses the standard AWS credential chain (workload role preferred).
