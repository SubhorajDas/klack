# Application settings used by host-run commands. The development Compose stack intentionally
# forces APP_ENV=development while sharing the remaining settings below.
APP_ENV=development
APP_NAME=klack-api
APP_VERSION=0.1.0
APP_DEBUG=false
API_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL container settings used by Compose. Keep local credentials URL-safe because Compose
# constructs the container-internal DATABASE_URL from these values.
POSTGRES_DB=klack
POSTGRES_USER=klack
POSTGRES_PASSWORD=klack_dev
POSTGRES_PORT=5432

# Host-only application connection. Compose replaces this with a URL that uses the `postgres`
# service hostname.
DATABASE_URL=postgresql+asyncpg://klack:klack_dev@127.0.0.1:5432/klack

# SQLAlchemy and database safeguards
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Operational endpoints
HEALTHCHECK_TIMEOUT_SECONDS=2

# Development-container file watching; polling is reliable across Windows, WSL, macOS, and Linux.
WATCHFILES_FORCE_POLLING=true
